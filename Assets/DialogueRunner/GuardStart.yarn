title: Guard
---
<<declare $hasKeycard = false as Bool>>
<<declare $dronesCleared = 0 as Number>>

<<if $hasKeycard && $dronesCleared >= 3>>
    <<jump Guard_MissionComplete>>
<<elseif $hasKeycard>>
    <<jump Guard_HasKeycardOnly>>
<<else>>
    <<jump Guard_NoKeycard>>
<<endif>>
